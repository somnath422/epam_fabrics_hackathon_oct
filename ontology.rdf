  </owl:DatatypeProperty>
  <owl:Class rdf:about="&fabric;UsageObservation">
    <rdfs:comment rdf:datatype="&xsd;string">A daily account-level usage observation sourced from silver_usage_daily, including active users, sessions, feature events, API calls, and licensed seats. One record represents one account on one snapshot date.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">UsageObservation</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Daily Usage</skos:altLabel>
    <skos:altLabel rdf:datatype="&xsd;string">Usage Snapshot</skos:altLabel>
  </owl:Class>
