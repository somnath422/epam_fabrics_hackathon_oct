<rdf:RDF xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:fabric="https://fabric.microsoft.com/ontology/64fe7b5a-c5ca-430a-a0e9-6760a11d5665#" xmlns:ns0="urn:fabric-internal:" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <owl:Ontology rdf:about="https://fabric.microsoft.com/ontology/64fe7b5a-c5ca-430a-a0e9-6760a11d5665">
    <rdfs:label rdf:datatype="&xsd;string">ont_customer_intelligence</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="&fabric;Account">
    <rdfs:comment rdf:datatype="&xsd;string">One synthetic SaaS customer account. Identity is scoped by tenant_id and account_id. Account attributes are sourced from silver_account.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">Account</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Customer</skos:altLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&fabric;Account__account_id">
    <rdfs:domain rdf:resource="&fabric;Account" />
    <rdfs:label rdf:datatype="&xsd;string">account_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;Account__tenant_id">
    <rdfs:domain rdf:resource="&fabric;Account" />
    <rdfs:label rdf:datatype="&xsd;string">tenant_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&fabric;Contact">
    <rdfs:comment rdf:datatype="&xsd;string">The synthetic primary contact associated with an account, sourced from silver_contact. The contact is identified by tenant_id and primary_contact_id; this dataset has one primary contact per account.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">Contact</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Customer Contact</skos:altLabel>
    <skos:altLabel rdf:datatype="&xsd;string">Primary Contact</skos:altLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&fabric;Contact__account_id">
    <rdfs:domain rdf:resource="&fabric;Contact" />
    <rdfs:label rdf:datatype="&xsd;string">account_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;Contact__tenant_id">
    <rdfs:domain rdf:resource="&fabric;Contact" />
    <rdfs:label rdf:datatype="&xsd;string">tenant_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&fabric;InteractionObservation">
    <rdfs:comment rdf:datatype="&xsd;string">Daily account-level interaction aggregates sourced from silver_interaction_daily. These are rolling engagement measures, not individual meeting or contact events.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">InteractionObservation</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Enghagement Snapshot</skos:altLabel>
    <skos:altLabel rdf:datatype="&xsd;string">Interaction Metrics</skos:altLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&fabric;InteractionObservation__account_id">
    <rdfs:domain rdf:resource="&fabric;InteractionObservation" />
    <rdfs:label rdf:datatype="&xsd;string">account_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;InteractionObservation__snapshot_date">
    <rdfs:domain rdf:resource="&fabric;InteractionObservation" />
    <rdfs:label rdf:datatype="&xsd;string">snapshot_date</rdfs:label>
    <rdfs:range rdf:resource="&xsd;dateTime" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;InteractionObservation__tenant_id">
    <rdfs:domain rdf:resource="&fabric;InteractionObservation" />
    <rdfs:label rdf:datatype="&xsd;string">tenant_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&fabric;SubscriptionSnapshot">
    <rdfs:comment rdf:datatype="&xsd;string">A daily snapshot of an account’s subscription attributes, sourced from silver_subscription_daily. The same subscription may appear on multiple snapshot dates. This entity intentionally excludes cancellation and status fields that could reveal future churn.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">SubscriptionSnapshot</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Daily Subscription</skos:altLabel>
    <skos:altLabel rdf:datatype="&xsd;string">Subscription Snapshot</skos:altLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&fabric;SubscriptionSnapshot__account_id">
    <rdfs:domain rdf:resource="&fabric;SubscriptionSnapshot" />
    <rdfs:label rdf:datatype="&xsd;string">account_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;SubscriptionSnapshot__snapshot_date">
    <rdfs:domain rdf:resource="&fabric;SubscriptionSnapshot" />
    <rdfs:label rdf:datatype="&xsd;string">snapshot_date</rdfs:label>
    <rdfs:range rdf:resource="&xsd;dateTime" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&fabric;SubscriptionSnapshot__tenant_id">
    <rdfs:domain rdf:resource="&fabric;SubscriptionSnapshot" />
    <rdfs:label rdf:datatype="&xsd;string">tenant_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
    <ns0:qualifiedPropertyName rdf:datatype="&xsd;string">true</ns0:qualifiedPropertyName>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&fabric;SupportObservation">
    <rdfs:comment rdf:datatype="&xsd;string">Daily account-level support aggregates sourced from silver_support_daily. These are summary metrics, not individual ticket records.</rdfs:comment>
    <rdfs:label rdf:datatype="&xsd;string">SupportObservation</rdfs:label>
    <skos:altLabel rdf:datatype="&xsd;string">Support Metrics</skos:altLabel>
    <skos:altLabel rdf:datatype="&xsd;string">Support Snapshot</skos:altLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&fabric;SupportObservation__account_id">
    <rdfs:domain rdf:resource="&fabric;SupportObservation" />
    <rdfs:label rdf:datatype="&xsd;string">account_id</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
